<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="bill_template" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <detail>
        <band height="125">
            <textField>
                <reportElement x="0" y="0" width="200" height="30"/>
                <textElement/>
                <textFieldExpression><![CDATA["Bill ID: " + $F{idBill}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="40" width="200" height="30"/>
                <textElement/>
                <textFieldExpression><![CDATA["Total Amount: " + $F{total}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="80" width="200" height="30"/>
                <textElement/>
                <textFieldExpression><![CDATA["Bill Date: " + $F{dateBill}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
